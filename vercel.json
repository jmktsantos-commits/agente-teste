{
    "framework": "nextjs",
    "buildCommand": "npm run build",
    "outputDirectory": ".next",
    "crons": [
        {
            "path": "/api/cron/trial-notifications",
            "schedule": "0 0 * * *"
        },
        {
            "path": "/api/cron/scrape-crash",
            "schedule": "*/2 * * * *"
        }
    ]
}